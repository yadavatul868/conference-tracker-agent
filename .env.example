# Environment configuration
# Copy this file to .env and fill in any overrides.
# .env is gitignored and should never be committed.

# Ollama model to use (default: llama3.1:8b)
# OLLAMA_MODEL=llama3.1:8b

# Default research topic
# TRACKER_TOPIC=applied AI, healthcare AI, NLP, general ML research

# Max search rounds before forcing a summary
# MAX_TOOL_ROUNDS=6

# Output file path
# OUTPUT_FILE=conferences.md
